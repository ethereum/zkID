{
  "name": "@openac/registry-server",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAC registries served off chain: approved issuers (issuer hiding) and one shared revocation registry, as an HTTP server and client.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "openac-registry-server": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@coordination-network/issuer-registry": "0.3.0",
    "@coordination-network/revocation-registry": "0.3.0",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  },
  "packageManager": "yarn@4.13.0"
}
